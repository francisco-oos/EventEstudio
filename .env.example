NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SITE_URL=http://localhost:3000
TRUST_PROXY=false

# Genera una cadena aleatoria de 32 bytes o más. Obligatoria en producción.
SESSION_SECRET=
SESSION_COOKIE=eventstudio_session
SESSION_HOURS=12

# La producción inicia sin cuentas ni eventos demo. Configura el primer owner
# sólo durante el aprovisionamiento y retira la contraseña del entorno después.
INITIAL_OWNER_NAME=Propietario EventStudio
INITIAL_OWNER_EMAIL=
INITIAL_OWNER_PASSWORD=

ALLOW_PUBLIC_REGISTRATION=false
TRIAL_DAYS=7
# El acceso con Google permanece oculto hasta completar el flujo OAuth.
GOOGLE_CLIENT_ID=

# El pago demo está bloqueado en producción aunque estas variables se alteren.
# Para cobro real usa PAYMENT_PROVIDER=mercadopago y completa ambas credenciales.
PAYMENT_PROVIDER=disabled
ENABLE_DEMO_PAYMENTS=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAYMENT_TIMEOUT_MS=12000

# Traducción opcional de textos personalizados. El endpoint debe aceptar un
# POST compatible con LibreTranslate y devolver { "translatedText": "..." }.
# La clave permanece sólo en el servidor; nunca se envía al panel.
TRANSLATION_ENDPOINT=
TRANSLATION_API_KEY=

# Volumen persistente: base, fotos, multimedia y respaldos.
STORAGE_ROOT=
DATA_DIR=
DB_PATH=
UPLOADS_DIR=
BACKUPS_DIR=
BACKUP_RETENTION=14
MAX_UPLOAD_MB=25
MAX_RESTORE_MB=4096
MAX_RESTORE_UNPACKED_MB=8192
MAX_RESTORE_FILES=10000

# La purga automática es opt-in y nunca elimina eventos protegidos.
ENABLE_AUTOMATIC_PURGE=false

# Spotify funciona pegando un enlace y usando el reproductor oficial; no requiere
# credenciales de desarrollador en esta versión.

# manual | simulation | whatsapp-cloud
# Puedes usar las variables simples de abajo para un solo número.
WHATSAPP_PROVIDER=manual
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_INVITATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=es_MX

# Perfiles opcionales: cambia solamente WHATSAPP_ACTIVE_PROFILE para sustituir
# el número del negocio sin tocar código. Cada perfil acepta las mismas claves.
# Ejemplo: BODA ahora y NEGOCIO después.
WHATSAPP_ACTIVE_PROFILE=
WHATSAPP_BODA_PROVIDER=whatsapp-cloud
WHATSAPP_BODA_GRAPH_VERSION=
WHATSAPP_BODA_PHONE_NUMBER_ID=
WHATSAPP_BODA_BUSINESS_ACCOUNT_ID=
WHATSAPP_BODA_ACCESS_TOKEN=
WHATSAPP_BODA_APP_SECRET=
WHATSAPP_BODA_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BODA_INVITATION_TEMPLATE=
WHATSAPP_BODA_TEMPLATE_LANGUAGE=es_MX
